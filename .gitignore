# Growth-skill working state — Netlify publishes the repo root, so this must never deploy
growth/

# Legacy audit/monitor reports — internal working files, same reason as growth/.
# These were tracked and therefore publicly readable at clearhead.in/audits/ until 2026-08-06.
audits/

# Environment variables — never commit real credentials
.env
.env.local
.env.*.local

# Dependencies
node_modules/

# Netlify
.netlify/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Growth-skill source copies — strategy docs, must never deploy (Netlify publishes the repo root)
*.skill

# Brand assets and data exports that live in the working tree but must never deploy.
# CLAUDE.md's deploy instruction is `git add -A`, so anything left untracked here would
# otherwise be published at clearhead.in/<name> on the next commit.
brand-kit/
clearhead-brand-kit.pdf
*.xlsx

# Stray archives (e.g. files.zip handoffs) — `git add -A` would publish them at clearhead.in/<name>.zip
*.zip
